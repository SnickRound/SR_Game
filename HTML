    <script>
        const tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
        if (tg) {
            tg.ready();
            tg.expand();
        }

        // ЗВУКОВОЙ ДВИЖОК (Web Audio API)
        const SoundFX = {
            enabled: true,
            ctx: null,
            ensureCtx() {
                if (!this.ctx) {
                    const AC = window.AudioContext || window.webkitAudioContext;
                    if (AC) this.ctx = new AC();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            },
            playTone(freq, type = 'sine', duration = 0.08, gainVal = 0.12, delay = 0) {
                if (!this.enabled) return;
                this.ensureCtx();
                if (!this.ctx) return;
                const t = this.ctx.currentTime + delay;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, t);
                gain.gain.setValueAtTime(gainVal, t);
                gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(t);
                osc.stop(t + duration);
            },
            click() { this.playTone(540, 'triangle', 0.05, 0.08); },
            tick() { this.playTone(880, 'square', 0.025, 0.045); },
            win(epic = false) {
                this.playTone(523.25, 'triangle', 0.13, 0.13, 0);
                this.playTone(659.25, 'triangle', 0.13, 0.13, 0.08);
                this.playTone(783.99, 'triangle', 0.2, 0.15, 0.16);
                if (epic) this.playTone(1046.5, 'sine', 0.35, 0.17, 0.26);
            },
            lose() {
                this.playTone(220, 'sawtooth', 0.16, 0.11, 0);
                this.playTone(150, 'sawtooth', 0.24, 0.11, 0.11);
            }
        };

        function toggleSound() {
            SoundFX.enabled = !SoundFX.enabled;
            document.getElementById('sound-toggle-btn').textContent = SoundFX.enabled ? '🔊' : '🔇';
            if (SoundFX.enabled) SoundFX.click();
        }

        // КОНФЕТТИ ПРИ КРУПНОМ ВЫИГРЫШЕ
        function spawnConfetti() {
            const colors = ['#FACC15', '#8B5CF6', '#D946EF', '#22C55E', '#FFFFFF'];
            for (let i = 0; i < 32; i++) {
                const el = document.createElement('div');
                el.className = 'confetti-piece';
                el.style.left = (Math.random() * 100) + 'vw';
                el.style.top = '-12px';
                el.style.background = colors[i % colors.length];
                el.style.transform = `rotate(${Math.random() * 360}deg)`;
                document.body.appendChild(el);

                const fallDuration = 1200 + Math.random() * 900;
                const drift = (Math.random() - 0.5) * 160;
                el.animate([
                    { transform: 'translate3d(0, 0, 0) rotate(0deg)', opacity: 1 },
                    { transform: `translate3d(${drift}px, 100vh, 0) rotate(540deg)`, opacity: 0 }
                ], { duration: fallDuration, easing: 'cubic-bezier(0.25, 0.8, 0.25, 1)' }).onfinish = () => el.remove();
            }
        }

        // СОСТОЯНИЕ
        const INITIAL_STATE = {
            balance: 500,
            lastDailyOpen: 0,
            gamesPlayed: 0,
            casesOpened: 0,
            bestWin: 0,
            tgClicked: false,
            tasksDone: { tg: false, case: false, games: false }
        };

        let state = JSON.parse(localStorage.getItem('sr_game_v1_state') || 'null') || structuredClone(INITIAL_STATE);
        state.tasksDone = Object.assign({ tg: false, case: false, games: false }, state.tasksDone || {});

        function saveState() {
            localStorage.setItem('sr_game_v1_state', JSON.stringify(state));
            renderAll();
        }

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.remove('opacity-0');
            t.classList.add('opacity-100');
            clearTimeout(window._toastTimer);
            window._toastTimer = setTimeout(() => {
                t.classList.remove('opacity-100');
                t.classList.add('opacity-0');
            }, 2200);
        }

        function rewardCoins(amount, title = 'Выигрыш', emoji = '🪙', confetti = false) {
            state.balance += amount;
            if (amount > state.bestWin) state.bestWin = amount;
            saveState();
            SoundFX.win(confetti || amount >= 500);
            if (confetti || amount >= 500) spawnConfetti();

            document.getElementById('win-modal-emoji').textContent = emoji;
            document.getElementById('win-modal-title').textContent = title;
            document.getElementById('win-modal-amount').textContent = `+${amount} монет`;
            document.getElementById('win-modal').classList.remove('hidden');
            document.getElementById('win-modal').classList.add('flex');
        }

        function closeWinModal() {
            SoundFX.click();
            document.getElementById('win-modal').classList.add('hidden');
            document.getElementById('win-modal').classList.remove('flex');
        }

        // ИМЯ ИГРОКА ИЗ TELEGRAM
        function initPlayerName() {
            let name = 'SR Player';
            if (tg && tg.initDataUnsafe && tg.initDataUnsafe.user) {
                name = tg.initDataUnsafe.user.first_name || 'SR Player';
            }
            document.getElementById('header-username').textContent = name;
            document.getElementById('profile-username').textContent = name;
        }

        // LIVE ЛЕНТА
        const LIVE_DROPS = [
            { icon: '🪙', label: '+100' },
            { icon: '💎', label: '+500' },
            { icon: '👑', label: '+1000' },
            { icon: '🎰', label: 'x12' },
            { icon: '🚀', label: 'x3.4' },
            { icon: '🎁', label: '+250' }
        ];

        function pushLiveDrop() {
            const feed = document.getElementById('live-feed');
            const item = LIVE_DROPS[Math.floor(Math.random() * LIVE_DROPS.length)];
            const div = document.createElement('div');
            div.className = 'shrink-0 bg-sr-card border border-white/10 rounded-xl px-2.5 py-1.5 flex items-center gap-1.5';
            div.innerHTML = `<span class="text-base">${item.icon}</span><span class="text-[11px] font-extrabold text-sr-gold">${item.label}</span>`;
            feed.prepend(div);
            if (feed.children.length > 6) feed.removeChild(feed.lastChild);
        }

        for (let i = 0; i < 5; i++) pushLiveDrop();
        setInterval(() => {
            pushLiveDrop();
            document.getElementById('online-count').textContent = (120 + Math.floor(Math.random() * 45)) + ' 👥';
        }, 3000);

        // НАВИГАЦИЯ
        const ALL_VIEWS = ['view-games', 'view-case', 'view-slots', 'view-mines', 'view-crash', 'view-tasks', 'view-top', 'view-profile'];

        function showView(viewId) {
            ALL_VIEWS.forEach(id => document.getElementById(id).classList.add('hidden'));
            document.getElementById(viewId).classList.remove('hidden');
        }

        function switchTab(tab) {
            SoundFX.click();
            ['games', 'tasks', 'top', 'profile'].forEach(t => {
                const btn = document.getElementById('nav-' + t);
                btn.classList.remove('text-sr-gold');
                btn.classList.add('text-gray-400');
            });
            const activeNav = document.getElementById('nav-' + tab);
            if (activeNav) {
                activeNav.classList.remove('text-gray-400');
                activeNav.classList.add('text-sr-gold');
            }
            showView('view-' + tab);
            if (tab === 'top') renderLeaderboard();
            renderAll();
        }

        function openGame(game) {
            SoundFX.click();
            showView('view-' + game);
            if (game === 'mines') renderMinesGrid();
        }

        // КЕЙСЫ (STANDOFF 2 РУЛЕТКА)
        const CASE_CONFIGS = {
            daily: {
                name: 'Daily Case',
                cost: 0,
                items: [
                    { name: 'Монеты', emoji: '🪙', amount: 50, rarity: 'common', weight: 38 },
                    { name: 'Пачка', emoji: '💵', amount: 120, rarity: 'common', weight: 28 },
                    { name: 'Кристалл', emoji: '🔮', amount: 250, rarity: 'rare', weight: 18 },
                    { name: 'Алмаз', emoji: '💎', amount: 500, rarity: 'epic', weight: 11 },
                    { name: 'Корона', emoji: '👑', amount: 1000, rarity: 'legendary', weight: 5 }
                ]
            },
            neon: {
                name: 'Neon Case',
                cost: 200,
                items: [
                    { name: 'Монеты', emoji: '🪙', amount: 100, rarity: 'common', weight: 35 },
                    { name: 'Искра', emoji: '⚡', amount: 220, rarity: 'rare', weight: 30 },
                    { name: 'Кристалл', emoji: '🔮', amount: 450, rarity: 'epic', weight: 22 },
                    { name: 'Корона', emoji: '👑', amount: 1200, rarity: 'legendary', weight: 13 }
                ]
            },
            gold: {
                name: 'Royal Case',
                cost: 750,
                items: [
                    { name: 'Пачка', emoji: '💵', amount: 350, rarity: 'common', weight: 32 },
                    { name: 'Алмаз', emoji: '💎', amount: 850, rarity: 'rare', weight: 32 },
                    { name: 'Огонь', emoji: '🔥', amount: 1800, rarity: 'epic', weight: 23 },
                    { name: 'Трофей', emoji: '🏆', amount: 4500, rarity: 'legendary', weight: 13 }
                ]
            }
        };

        let currentCase = 'daily';
        let caseSpinning = false;

        function openCaseScreen(type = 'daily') {
            SoundFX.click();
            showView('view-case');
            selectCaseType(type);
        }

        function selectCaseType(type) {
            if (caseSpinning) return;
            currentCase = type;
            ['daily', 'neon', 'gold'].forEach(t => {
                const el = document.getElementById('case-tab-' + t);
                if (t === type) {
                    el.classList.remove('border-white/10', 'bg-sr-card');
                    el.classList.add('border-sr-gold', 'bg-sr-gold/15');
                } else {
                    el.classList.remove('border-sr-gold', 'bg-sr-gold/15');
                    el.classList.add('border-white/10', 'bg-sr-card');
                }
            });

            const cfg = CASE_CONFIGS[type];
            document.getElementById('case-contents-grid').innerHTML = cfg.items.map(it => `
                <div class="rarity-${it.rarity} rounded-2xl p-2.5 text-center border border-white/10">
                    <div class="text-2xl">${it.emoji}</div>
                    <div class="text-[11px] font-bold text-white mt-0.5">${it.name}</div>
                    <div class="text-xs font-black text-sr-gold">+${it.amount}</div>
                </div>
            `).join('');

            buildCaseStrip(cfg.items);
            updateDailyTimers();
        }

        function buildCaseStrip(items, winner = null, winIdx = 36) {
            const track = document.getElementById('roulette-track');
            track.style.transition = 'none';
            track.style.transform = 'translateX(0px)';

            const viewportW = document.getElementById('roulette-viewport').offsetWidth || 360;
            const centerOffset = viewportW / 2;

            let html = '';
            for (let i = 0; i < 44; i++) {
                const it = (winner && i === winIdx) ? winner : items[Math.floor(Math.random() * items.length)];
                html += `
                    <div class="r-card rarity-${it.rarity} w-24 h-28 shrink-0 rounded-2xl border border-white/10 flex flex-col items-center justify-center p-2">
                        <div class="text-3xl">${it.emoji}</div>
                        <div class="text-[10px] font-bold text-white/80 mt-1">${it.name}</div>
                        <div class="text-xs font-black text-sr-gold">+${it.amount}</div>
                    </div>
                `;
            }
            track.innerHTML = html;
            track.dataset.centerOffset = centerOffset;
        }

        function pickWeighted(items) {
            const sum = items.reduce((acc, i) => acc + i.weight, 0);
            let r = Math.random() * sum;
            for (const it of items) {
                if (r < it.weight) return it;
                r -= it.weight;
            }
            return items[0];
        }

        function getDailyLeftMs() {
            const day = 24 * 60 * 60 * 1000;
            return Math.max(0, (state.lastDailyOpen + day) - Date.now());
        }

        function fmtTimer(ms) {
            const sec = Math.ceil(ms / 1000);
            const h = String(Math.floor(sec / 3600)).padStart(2, '0');
            const m = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
            const s = String(sec % 60).padStart(2, '0');
            return `${h}:${m}:${s}`;
        }

        function updateDailyTimers() {
            const left = getDailyLeftMs();
            const bannerStatus = document.getElementById('daily-banner-status');
            const spinBtn = document.getElementById('btn-spin-case');

            if (left > 0) {
                const t = fmtTimer(left);
                bannerStatus.className = 'text-xs font-semibold text-amber-300 flex items-center gap-1';
                bannerStatus.innerHTML = `<span>⏱</span> Следующий через ${t}`;
            } else {
                bannerStatus.className = 'text-xs font-semibold text-emerald-400 flex items-center gap-1';
                bannerStatus.innerHTML = `<span>●</span> Доступен к открытию!`;
            }

            if (currentCase === 'daily') {
                if (left > 0) {
                    spinBtn.disabled = true;
                    spinBtn.textContent = `Через ${fmtTimer(left)}`;
                } else {
                    spinBtn.disabled = caseSpinning;
                    spinBtn.textContent = 'Открыть бесплатно';
                }
            } else {
                spinBtn.disabled = caseSpinning;
                spinBtn.textContent = `Открыть за ${CASE_CONFIGS[currentCase].cost} монет`;
            }
        }

        setInterval(updateDailyTimers, 1000);

        function resetDailyTimer() {
            SoundFX.click();
            state.lastDailyOpen = 0;
            saveState();
            updateDailyTimers();
            showToast('Таймер Daily Case сброшен');
        }

        function spinCase() {
            if (caseSpinning) return;
            const cfg = CASE_CONFIGS[currentCase];

            if (currentCase === 'daily') {
                if (getDailyLeftMs() > 0) return;
                state.lastDailyOpen = Date.now();
            } else {
                if (state.balance < cfg.cost) {
                    showToast('Недостаточно монет!');
                    openShopModal();
                    return;
                }
                state.balance -= cfg.cost;
            }

            caseSpinning = true;
            state.casesOpened += 1;
            state.gamesPlayed += 1;
            saveState();
            updateDailyTimers();

            const winner = pickWeighted(cfg.items);
            const winIdx = 36;
            buildCaseStrip(cfg.items, winner, winIdx);

            const track = document.getElementById('roulette-track');
            const centerOffset = Number(track.dataset.centerOffset || 180);
            const cardW = 96; // w-24 = 96px
            const gap = 10;   // gap-2.5 = 10px
            const jitter = Math.floor(Math.random() * 44) - 22;
            const targetX = -(winIdx * (cardW + gap) + cardW / 2 + jitter) + centerOffset;

            let ticks = 0;
            const maxTicks = 28;
            function tickLoop() {
                if (!caseSpinning || ticks >= maxTicks) return;
                SoundFX.tick();
                ticks++;
                const delay = 50 + Math.pow(ticks / maxTicks, 2.2) * 280;
                setTimeout(tickLoop, delay);
            }
            tickLoop();

            requestAnimationFrame(() => {
                track.style.transition = 'transform 4.3s cubic-bezier(0.12, 0.85, 0.22, 1)';
                track.style.transform = `translateX(${targetX}px)`;
            });

            setTimeout(() => {
                caseSpinning = false;
                updateDailyTimers();
                const box = document.getElementById('roulette-box');
                box.classList.add('animate-shake');
                setTimeout(() => box.classList.remove('animate-shake'), 380);

                rewardCoins(winner.amount, `${cfg.name}: ${winner.name}`, winner.emoji, winner.rarity === 'legendary' || winner.rarity === 'epic');
            }, 4450);
        }

        // СЛОТЫ
        let slotsBet = 25;
        let slotsSpinning = false;
        const SLOT_ICONS = ['🍒', '🍋', '💎', '👑', '7️⃣'];

        function setSlotsBet(val) {
            SoundFX.click();
            slotsBet = val;
            document.getElementById('slots-bet-label').textContent = val + ' монет';
            document.querySelectorAll('.slots-bet-btn').forEach(btn => {
                const active = Number(btn.textContent) === val;
                btn.className = `slots-bet-btn py-2 rounded-xl text-xs font-extrabold border ${active ? 'bg-sr-purple/30 border-sr-purple text-white' : 'bg-white/5 border-white/10 text-white'}`;
            });
        }

        function playSlots() {
            if (slotsSpinning) return;
            if (state.balance < slotsBet) {
                showToast('Недостаточно монет!');
                openShopModal();
                return;
            }
            state.balance -= slotsBet;
            state.gamesPlayed += 1;
            saveState();

            slotsSpinning = true;
            document.getElementById('btn-spin-slots').disabled = true;
            document.getElementById('slots-status').textContent = 'Барабаны крутятся...';

            const reels = [0, 1, 2].map(i => document.getElementById('reel-' + i));
            const spinInt = setInterval(() => {
                SoundFX.tick();
                reels.forEach(r => {
                    r.textContent = SLOT_ICONS[Math.floor(Math.random() * SLOT_ICONS.length)];
                    r.style.transform = 'translateY(-3px)';
                    setTimeout(() => r.style.transform = 'translateY(0px)', 45);
                });
            }, 85);

            setTimeout(() => {
                clearInterval(spinInt);
                const res = [0, 1, 2].map(() => SLOT_ICONS[Math.floor(Math.random() * SLOT_ICONS.length)]);
                res.forEach((sym, i) => reels[i].textContent = sym);

                let mult = 0;
                if (res[0] === res[1] && res[1] === res[2]) {
                    if (res[0] === '7️⃣') mult = 25;
                    else if (res[0] === '👑') mult = 12;
                    else if (res[0] === '💎') mult = 8;
                    else mult = 5;
                } else if (res[0] === res[1] || res[1] === res[2] || res[0] === res[2]) {
                    mult = 1.5;
                }

                if (mult > 0) {
                    const win = Math.round(slotsBet * mult);
                    document.getElementById('slots-status').textContent = `Выигрыш x${mult}!`;
                    rewardCoins(win, `Слоты (x${mult})`, res[0], mult >= 8);
                } else {
                    SoundFX.lose();
                    document.getElementById('slots-status').textContent = 'Не повезло — крути ещё!';
                    showToast('Мимо! Попробуй снова');
                }

                slotsSpinning = false;
                document.getElementById('btn-spin-slots').disabled = false;
            }, 1150);
        }

        // МИНЫ
        let minesBet = 20;
        let minesCount = 3;
        let minesActive = false;
        let mineSet = new Set();
        let openedSet = new Set();

        function setMinesBet(val) {
            SoundFX.click();
            minesBet = val;
            document.querySelectorAll('.mines-bet-btn').forEach(b => {
                const act = Number(b.textContent) === val;
                b.className = `mines-bet-btn py-1.5 rounded-lg text-xs font-bold border ${act ? 'bg-sr-purple/30 border-sr-purple text-white' : 'bg-white/5 border-white/10 text-white'}`;
            });
            if (!minesActive) document.getElementById('btn-mines-action').textContent = `Начать игру (${minesBet} монет)`;
        }

        function setMinesCount(cnt) {
            SoundFX.click();
            minesCount = cnt;
            document.querySelectorAll('.mines-cnt-btn').forEach(b => {
                const act = Number(b.textContent) === cnt;
                b.className = `mines-cnt-btn py-1.5 rounded-lg text-xs font-bold border ${act ? 'bg-sr-purple/30 border-sr-purple text-white' : 'bg-white/5 border-white/10 text-white'}`;
            });
        }

        function calcMinesMult(picks) {
            if (picks === 0) return 1;
            const risk = minesCount / 25;
            return +(1 + picks * (0.22 + risk * 0.85)).toFixed(2);
        }

        function renderMinesGrid() {
            const grid = document.getElementById('mines-grid');
            grid.innerHTML = '';
            for (let i = 0; i < 25; i++) {
                const cell = document.createElement('button');
                cell.className = 'aspect-square rounded-xl bg-sr-card hover:bg-sr-cardHover border border-white/10 flex items-center justify-center text-xl font-black transition active:scale-90';
                cell.textContent = '✦';
                cell.onclick = () => pickMineCell(i, cell);
                grid.appendChild(cell);
            }
        }

        function handleMinesAction() {
            const btn = document.getElementById('btn-mines-action');
            if (!minesActive) {
                if (state.balance < minesBet) {
                    showToast('Недостаточно монет!');
                    openShopModal();
                    return;
                }
                state.balance -= minesBet;
                state.gamesPlayed += 1;
                saveState();

                SoundFX.click();
                minesActive = true;
                openedSet.clear();
                mineSet.clear();
                while (mineSet.size < minesCount) {
                    mineSet.add(Math.floor(Math.random() * 25));
                }
                renderMinesGrid();
                document.getElementById('mines-mult-badge').textContent = 'x1.00';
                btn.textContent = `Забрать (${minesBet} монет)`;
                btn.className = 'w-full py-4 rounded-2xl font-black text-base uppercase tracking-wide bg-gradient-to-r from-sr-gold to-amber-500 text-black active:scale-95 transition shadow-lg';
            } else {
                const win = Math.round(minesBet * calcMinesMult(openedSet.size));
                minesActive = false;
                btn.textContent = `Начать игру (${minesBet} монет)`;
                btn.className = 'w-full py-4 rounded-2xl font-black text-base uppercase tracking-wide bg-gradient-to-r from-sr-purple to-sr-violet text-white active:scale-95 transition shadow-lg shadow-purple-600/30';
                rewardCoins(win, `Мины (x${calcMinesMult(openedSet.size)})`, '💎', openedSet.size >= 4);
            }
        }

        function pickMineCell(idx, cell) {
            if (!minesActive || openedSet.has(idx)) return;
            if (mineSet.has(idx)) {
                minesActive = false;
                SoundFX.lose();
                const grid = document.getElementById('mines-grid');
                grid.classList.add('animate-shake');
                setTimeout(() => grid.classList.remove('animate-shake'), 380);

                Array.from(grid.children).forEach((el, i) => {
                    if (mineSet.has(i)) {
                        el.textContent = '💣';
                        el.className = 'aspect-square rounded-xl bg-rose-500/25 border border-rose-500 flex items-center justify-center text-xl';
                    }
                });
                const btn = document.getElementById('btn-mines-action');
                btn.textContent = `Начать игру (${minesBet} монет)`;
                btn.className = 'w-full py-4 rounded-2xl font-black text-base uppercase tracking-wide bg-gradient-to-r from-sr-purple to-sr-violet text-white active:scale-95 transition shadow-lg shadow-purple-600/30';
                showToast('Бум! Попалась мина');
            } else {
                openedSet.add(idx);
                cell.textContent = '💎';
                cell.className = 'aspect-square rounded-xl bg-sr-gold/20 border border-sr-gold flex items-center justify-center text-xl';
                SoundFX.playTone(460 + openedSet.size * 55, 'triangle', 0.08, 0.11);

                const mult = calcMinesMult(openedSet.size);
                const curWin = Math.round(minesBet * mult);
                document.getElementById('mines-mult-badge').textContent = `x${mult.toFixed(2)}`;
                document.getElementById('btn-mines-action').textContent = `Забрать (${curWin} монет)`;
            }
        }

        // КРАШ
        let crashBet = 25;
        let crashRunning = false;
        let crashInterval = null;
        let crashMult = 1.0;
        let crashPoint = 1.0;

        function setCrashBet(val) {
            SoundFX.click();
            crashBet = val;
            document.getElementById('crash-bet-label').textContent = val + ' монет';
            document.querySelectorAll('.crash-bet-btn').forEach(b => {
                const act = Number(b.textContent) === val;
                b.className = `crash-bet-btn py-2 rounded-xl text-xs font-extrabold border ${act ? 'bg-sr-purple/30 border-sr-purple text-white' : 'bg-white/5 border-white/10 text-white'}`;
            });
        }

        function handleCrashAction() {
            const btn = document.getElementById('btn-crash-action');
            const multEl = document.getElementById('crash-mult');
            const statusEl = document.getElementById('crash-status');
            const rocketEl = document.getElementById('crash-rocket');

            if (!crashRunning) {
                if (state.balance < crashBet) {
                    showToast('Недостаточно монет!');
                    openShopModal();
                    return;
                }
                state.balance -= crashBet;
                state.gamesPlayed += 1;
                saveState();

                SoundFX.click();
                crashRunning = true;
                crashMult = 1.0;
                crashPoint = +(1.15 + Math.pow(Math.random(), 1.65) * 6.0).toFixed(2);
                rocketEl.textContent = '🚀';
                multEl.className = 'relative z-10 text-4xl font-black text-sr-gold text-glow-gold';
                statusEl.textContent = 'Ракета летит — жми «Забрать»!';
                btn.textContent = `Забрать (${crashBet} монет)`;

                crashInterval = setInterval(() => {
                    crashMult = +(crashMult + 0.04 + crashMult * 0.016).toFixed(2);
                    multEl.textContent = crashMult.toFixed(2) + 'x';
                    const lift = Math.min(36, (crashMult - 1) * 11);
                    rocketEl.style.transform = `translate(${Math.min(18, lift * 0.4)}px, ${-lift}px) rotate(12deg)`;
                    btn.textContent = `Забрать (${Math.round(crashBet * crashMult)} монет)`;

                    if (crashMult >= crashPoint) {
                        clearInterval(crashInterval);
                        crashRunning = false;
                        SoundFX.lose();
                        document.getElementById('crash-box').classList.add('animate-shake');
                        setTimeout(() => document.getElementById('crash-box').classList.remove('animate-shake'), 380);
                        rocketEl.textContent = '💥';
                        multEl.className = 'relative z-10 text-4xl font-black text-rose-500';
                        statusEl.textContent = `Краш на ${crashPoint.toFixed(2)}x!`;
                        btn.textContent = 'Запустить ракету';
                        setTimeout(() => {
                            rocketEl.textContent = '🚀';
                            rocketEl.style.transform = 'translate(0px, 0px) rotate(0deg)';
                        }, 1100);
                    }
                }, 115);
            } else {
                clearInterval(crashInterval);
                crashRunning = false;
                const win = Math.round(crashBet * crashMult);
                rocketEl.style.transform = 'translate(0px, 0px) rotate(0deg)';
                statusEl.textContent = `Забрано на ${crashMult.toFixed(2)}x!`;
                btn.textContent = 'Запустить ракету';
                rewardCoins(win, `Краш (${crashMult.toFixed(2)}x)`, '🚀', crashMult >= 2.5);
            }
        }

        // ЗАДАНИЯ (Включая подписку на канал SR_Store)
        function handleTgTask() {
            if (state.tasksDone.tg) return;
            const url = 'https://t.me/snickround_store';
            if (!state.tgClicked) {
                state.tgClicked = true;
                saveState();
                if (tg && tg.openTelegramLink) tg.openTelegramLink(url);
                else window.open(url, '_blank');
                showToast('Перейди в SR_Store и нажми «Проверить»');
                return;
            }
            state.tasksDone.tg = true;
            saveState();
            rewardCoins(250, 'Подписка на SR_Store', '📢', true);
        }

        function claimMilestoneTask(key, reward, cond, failMsg) {
            if (state.tasksDone[key]) return;
            if (!cond) {
                SoundFX.click();
                showToast(failMsg);
                return;
            }
            state.tasksDone[key] = true;
            saveState();
            rewardCoins(reward, 'Награда за задание', '⚡', true);
        }

        // ТОП ИГРОКОВ
        function renderLeaderboard() {
            const userName = document.getElementById('header-username').textContent;
            const list = [
                { name: 'MaxPower', score: 16400 },
                { name: 'VibeSnick', score: 11250 },
                { name: 'LuckyShot', score: 7400 },
                { name: 'NeonGhost', score: 3850 },
                { name: `${userName} (Вы)`, score: state.balance, isMe: true },
                { name: 'Rookie99', score: 950 }
            ].sort((a, b) => b.score - a.score);

            document.getElementById('leaderboard-list').innerHTML = list.map((p, idx) => `
                <div class="flex items-center justify-between rounded-2xl px-4 py-3 border ${p.isMe ? 'bg-sr-purple/20 border-sr-gold' : 'bg-sr-card border-white/10'}">
                    <div class="flex items-center gap-3">
                        <span class="text-sm font-black ${idx < 3 ? 'text-sr-gold' : 'text-gray-400'}">#${idx + 1}</span>
                        <span class="text-sm font-bold text-white">${p.name}</span>
                    </div>
                    <span class="text-sm font-black text-sr-gold">🪙 ${p.score}</span>
                </div>
            `).join('');
        }

        // МАГАЗИН МОНЕТ
        function openShopModal() {
            SoundFX.click();
            document.getElementById('shop-modal').classList.remove('hidden');
            document.getElementById('shop-modal').classList.add('flex');
        }

        function closeShopModal() {
            SoundFX.click();
            document.getElementById('shop-modal').classList.add('hidden');
            document.getElementById('shop-modal').classList.remove('flex');
        }

        function addShopCoins(amount) {
            closeShopModal();
            rewardCoins(amount, 'Пополнение баланса', '🪙', true);
        }

        function resetProgress() {
            SoundFX.click();
            state = structuredClone(INITIAL_STATE);
            saveState();
            updateDailyTimers();
            showToast('Прогресс сброшен');
        }

        // РЕНДЕР ВСЕХ ДАННЫХ
        function renderAll() {
            document.getElementById('balance-display').textContent = state.balance;
            document.getElementById('stat-balance').textContent = state.balance;
            document.getElementById('stat-games').textContent = state.gamesPlayed;
            document.getElementById('stat-cases').textContent = state.casesOpened;
            document.getElementById('stat-best').textContent = state.bestWin;
            document.getElementById('task-games-progress').textContent = Math.min(5, state.gamesPlayed);

            const tgBtn = document.getElementById('task-btn-tg');
            if (state.tasksDone.tg) {
                tgBtn.textContent = 'Получено';
                tgBtn.className = 'px-3.5 py-2 rounded-xl bg-emerald-500/20 text-emerald-300 text-xs font-black shrink-0';
            } else if (state.tgClicked) {
                tgBtn.textContent = 'Проверить';
            }

            ['case', 'games'].forEach(k => {
                const b = document.getElementById('task-btn-' + k);
                if (state.tasksDone[k]) {
                    b.textContent = 'Получено';
                    b.className = 'px-3.5 py-2 rounded-xl bg-emerald-500/20 text-emerald-300 text-xs font-black shrink-0';
                }
            });
        }

        initPlayerName();
        selectCaseType('daily');
        renderMinesGrid();
        renderAll();
    </script>
</body>
</html>
