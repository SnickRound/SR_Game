<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SR_Game — SnickRound_Game</title>
    <!-- Подключение Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Подключение Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Шрифт Inter для игровых акцентов -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        sr: {
                            bg: '#09090E',
                            card: '#13131D',
                            cardHover: '#1B1B29',
                            purple: '#8B5CF6',
                            violet: '#A855F7',
                            gold: '#FACC15',
                            amber: '#F59E0B',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        *, *::before, *::after {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }

        body {
            background-color: #050508;
            color: #FFFFFF;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            user-select: none;
        }

        /* Скрытие скроллбаров для аккуратного мобильного вида */
        ::-webkit-scrollbar {
            width: 0px;
            height: 0px;
        }

        /* Неоновые свечения */
        .glow-purple {
            box-shadow: 0 0 24px rgba(139, 92, 246, 0.35);
        }
        .glow-gold {
            box-shadow: 0 0 24px rgba(250, 204, 21, 0.3);
        }
        .text-glow-gold {
            text-shadow: 0 0 12px rgba(250, 204, 21, 0.6);
        }
        .text-glow-purple {
            text-shadow: 0 0 12px rgba(168, 85, 247, 0.7);
        }

        /* Градиентный фон верхней шапки в духе референса */
        .top-aura {
            background: radial-gradient(circle at 50% -20%, rgba(168, 85, 247, 0.42) 0%, rgba(139, 92, 246, 0.12) 45%, rgba(9, 9, 14, 0) 75%);
        }

        /* Анимация пульсации LIVE точки */
        @keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }
        .live-dot {
            animation: pulseDot 1.5s infinite ease-in-out;
        }

        /* Анимация парения элементов на карточках */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-5px); }
        }
        .animate-float {
            animation: floatSlow 3.2s ease-in-out infinite;
        }

        /* Анимация тряски при открытии/взрыве */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }
        .animate-shake {
            animation: shake 0.35s ease-in-out;
        }

        /* Полоски редкости в стиле Standoff 2 */
        .rarity-common {
            border-bottom: 4px solid #E2E8F0;
            background: linear-gradient(180deg, rgba(226,232,240,0.08) 0%, rgba(226,232,240,0.22) 100%);
        }
        .rarity-rare {
            border-bottom: 4px solid #8B5CF6;
            background: linear-gradient(180deg, rgba(139,92,246,0.12) 0%, rgba(139,92,246,0.32) 100%);
        }
        .rarity-epic {
            border-bottom: 4px solid #D946EF;
            background: linear-gradient(180deg, rgba(217,70,239,0.15) 0%, rgba(217,70,239,0.38) 100%);
        }
        .rarity-legendary {
            border-bottom: 4px solid #FACC15;
            background: linear-gradient(180deg, rgba(250,204,21,0.18) 0%, rgba(250,204,21,0.42) 100%);
        }

        /* Конфетти частиц */
        .confetti-piece {
            position: fixed;
            width: 8px;
            height: 8px;
            pointer-events: none;
            z-index: 100;
            border-radius: 2px;
        }
    </style>
</head>
<body class="flex justify-center min-h-screen bg-[#050508]">

    <!-- Основной контейнер мобильного приложения -->
    <div id="app-shell" class="relative w-full max-w-[430px] min-h-screen bg-sr-bg flex flex-col justify-between overflow-hidden shadow-2xl border-x border-white/5">

        <!-- Верхнее фиолетовое свечение -->
        <div class="top-aura absolute top-0 left-0 right-0 h-64 pointer-events-none z-0"></div>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: Профиль + Звук + Баланс монет -->
        <header class="relative z-20 px-4 pt-3 pb-2 flex items-center justify-between gap-2">
            <!-- Левая плашка игрока -->
            <div onclick="switchTab('profile')" class="flex items-center gap-2.5 bg-white/5 hover:bg-white/10 active:scale-95 transition cursor-pointer backdrop-blur-md border border-white/10 rounded-full py-1.5 pl-1.5 pr-3.5">
                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-sr-purple via-sr-violet to-sr-gold p-[2px] shrink-0">
                    <div class="w-full h-full rounded-full bg-sr-bg flex items-center justify-center font-black text-xs text-white">
                        SR
                    </div>
                </div>
                <div class="leading-tight">
                    <div id="header-username" class="text-xs font-bold text-white truncate max-w-[95px]">SR Player</div>
                    <div class="text-[10px] font-medium text-purple-300/80">SnickRound_Game</div>
                </div>
            </div>

            <!-- Правая часть: кнопка звука + баланс монет -->
            <div class="flex items-center gap-1.5">
                <button id="sound-toggle-btn" onclick="toggleSound()" aria-label="Звук" class="w-8 h-8 rounded-full bg-[#161622]/90 border border-white/10 hover:bg-white/10 active:scale-90 transition flex items-center justify-center text-sm">
                    🔊
                </button>

                <div class="flex items-center gap-2 bg-[#161622]/90 backdrop-blur-md border border-purple-500/30 rounded-full py-1 pl-3 pr-1 shadow-lg">
                    <div class="w-5 h-5 rounded-full bg-gradient-to-b from-yellow-300 to-amber-500 flex items-center justify-center text-[10px] font-black text-black shadow-sm shrink-0">
                        S
                    </div>
                    <span id="balance-display" class="text-sm font-extrabold text-white tracking-tight">500</span>
                    <button onclick="openShopModal()" aria-label="Пополнить монеты" class="w-7 h-7 rounded-full bg-gradient-to-tr from-sr-purple to-sr-violet hover:brightness-110 active:scale-90 transition flex items-center justify-center text-white font-bold text-base shadow-md shadow-purple-600/40">
                        +
                    </button>
                </div>
            </div>
        </header>

        <!-- ЛЕНТА LIVE-ДРОПОВ -->
        <section class="relative z-20 px-4 py-1.5">
            <div class="bg-[#12121B]/90 border border-white/10 rounded-2xl p-2 flex items-center gap-2 overflow-hidden">
                <div class="shrink-0 bg-purple-600/20 border border-purple-500/40 rounded-xl px-2.5 py-2 flex flex-col items-center justify-center min-w-[64px]">
                    <div class="flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-sr-gold live-dot"></span>
                        <span class="text-[10px] font-black tracking-wider text-white uppercase">LIVE</span>
                    </div>
                    <span id="online-count" class="text-[11px] font-bold text-purple-300 mt-0.5">148 👥</span>
                </div>

                <div id="live-feed" class="flex items-center gap-2 overflow-x-auto no-scrollbar w-full"></div>
            </div>
        </section>

        <!-- ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ ЭКРАНОВ -->
        <main id="main-content" class="relative z-10 flex-1 px-4 pt-2 pb-24 overflow-y-auto">

            <!-- ================= ЭКРАН 1: ИГРЫ (ГЛАВНАЯ) ================= -->
            <div id="view-games" class="space-y-3.5">

                <!-- БАННЕР DAILY CASE -->
                <div onclick="openCaseScreen('daily')" class="relative overflow-hidden rounded-3xl p-4 cursor-pointer active:scale-[0.98] transition border border-yellow-400/40 bg-gradient-to-r from-[#1E1438] via-[#2A1854] to-[#191528] glow-purple">
                    <div class="absolute -right-6 -top-6 w-28 h-28 rounded-full bg-sr-gold/20 blur-2xl pointer-events-none"></div>
                    <div class="absolute left-1/3 -bottom-8 w-28 h-28 rounded-full bg-purple-500/30 blur-2xl pointer-events-none"></div>

                    <div class="relative z-10 flex items-center justify-between gap-3">
                        <div class="space-y-1">
                            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sr-gold/20 border border-sr-gold/40">
                                <span class="text-[10px] font-extrabold text-sr-gold uppercase tracking-wider">Бесплатно раз в 24ч</span>
                            </div>
                            <h2 class="text-xl font-black text-white tracking-tight">DAILY CASE</h2>
                            <p id="daily-banner-status" class="text-xs font-semibold text-emerald-400 flex items-center gap-1">
                                <span>●</span> Доступен к открытию!
                            </p>
                        </div>

                        <div class="w-20 h-20 shrink-0 flex items-center justify-center animate-float">
                            <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-[0_8px_16px_rgba(250,204,21,0.45)]">
                                <defs>
                                    <linearGradient id="caseBody" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#8B5CF6"/>
                                        <stop offset="100%" stop-color="#3B0764"/>
                                    </linearGradient>
                                    <linearGradient id="caseGold" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#FEF08A"/>
                                        <stop offset="50%" stop-color="#FACC15"/>
                                        <stop offset="100%" stop-color="#D97706"/>
                                    </linearGradient>
                                </defs>
                                <rect x="14" y="34" width="72" height="48" rx="12" fill="url(#caseBody)" stroke="#FACC15" stroke-width="3"/>
                                <path d="M14 44 L86 44" stroke="#FACC15" stroke-width="3"/>
                                <rect x="26" y="32" width="8" height="52" rx="2" fill="url(#caseGold)"/>
                                <rect x="66" y="32" width="8" height="52" rx="2" fill="url(#caseGold)"/>
                                <rect x="41" y="37" width="18" height="16" rx="4" fill="url(#caseGold)" stroke="#1E1B4B" stroke-width="2"/>
                                <circle cx="50" cy="45" r="2.5" fill="#1E1B4B"/>
                                <circle cx="22" cy="20" r="3" fill="#FACC15"/>
                                <circle cx="80" cy="18" r="2.5" fill="#FFFFFF"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- ЗАГОЛОВОК СЕКЦИИ ИГР -->
                <div class="flex items-center justify-between pt-1">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-white/90">Режимы SR_Game</h3>
                    <span class="text-[11px] font-medium text-purple-300/70">Выбери игру</span>
                </div>

                <!-- СЕТКА ИГР 2x2 -->
                <div class="grid grid-cols-2 gap-3">
                    <div onclick="openCaseScreen('daily')" class="group relative h-40 rounded-3xl p-3.5 flex flex-col justify-between overflow-hidden cursor-pointer active:scale-95 transition border border-purple-400/30 bg-gradient-to-br from-[#6D28D9] via-[#4C1D95] to-[#1E1B4B]">
                        <div class="absolute -right-4 -top-4 w-24 h-24 rounded-full bg-white/10 blur-xl"></div>
                        <div class="flex justify-between items-start z-10">
                            <span class="px-2 py-0.5 rounded-lg bg-black/30 text-[10px] font-bold text-yellow-300 backdrop-blur-sm">FREE & VIP</span>
                        </div>
                        <div class="self-center my-auto z-10 text-5xl drop-shadow-lg group-hover:scale-110 transition animate-float">
                            🎁
                        </div>
                        <div class="z-10">
                            <div class="text-base font-black text-white tracking-tight">Кейсы</div>
                            <div class="text-[11px] text-purple-200/80 font-medium">Рулетка призов</div>
                        </div>
                    </div>

                    <div onclick="openGame('slots')" class="group relative h-40 rounded-3xl p-3.5 flex flex-col justify-between overflow-hidden cursor-pointer active:scale-95 transition border border-yellow-400/30 bg-gradient-to-br from-[#D97706] via-[#92400E] to-[#1C1917]">
                        <div class="absolute -right-4 -top-4 w-24 h-24 rounded-full bg-yellow-300/20 blur-xl"></div>
                        <div class="flex justify-between items-start z-10">
                            <span class="px-2 py-0.5 rounded-lg bg-black/30 text-[10px] font-bold text-white backdrop-blur-sm">до x25</span>
                        </div>
                        <div class="self-center my-auto z-10 text-5xl drop-shadow-lg group-hover:scale-110 transition animate-float">
                            🎰
                        </div>
                        <div class="z-10">
                            <div class="text-base font-black text-white tracking-tight">Слоты</div>
                            <div class="text-[11px] text-amber-200/80 font-medium">Классика 777</div>
                        </div>
                    </div>

                    <div onclick="openGame('mines')" class="group relative h-40 rounded-3xl p-3.5 flex flex-col justify-between overflow-hidden cursor-pointer active:scale-95 transition border border-white/15 bg-gradient-to-br from-[#27273A] via-[#181824] to-[#0D0D14]">
                        <div class="absolute -right-4 -top-4 w-24 h-24 rounded-full bg-purple-500/20 blur-xl"></div>
                        <div class="flex justify-between items-start z-10">
                            <span class="px-2 py-0.5 rounded-lg bg-purple-500/20 border border-purple-400/30 text-[10px] font-bold text-purple-300">5×5</span>
                        </div>
                        <div class="self-center my-auto z-10 text-5xl drop-shadow-lg group-hover:scale-110 transition animate-float">
                            💣
                        </div>
                        <div class="z-10">
                            <div class="text-base font-black text-white tracking-tight">Мины</div>
                            <div class="text-[11px] text-gray-300/80 font-medium">Найди золото</div>
                        </div>
                    </div>

                    <div onclick="openGame('crash')" class="group relative h-40 rounded-3xl p-3.5 flex flex-col justify-between overflow-hidden cursor-pointer active:scale-95 transition border border-purple-500/30 bg-gradient-to-br from-[#311042] via-[#1E1035] to-[#0D0B1A]">
                        <div class="absolute -right-4 -top-4 w-24 h-24 rounded-full bg-fuchsia-500/20 blur-xl"></div>
                        <div class="flex justify-between items-start z-10">
                            <span class="px-2 py-0.5 rounded-lg bg-yellow-400/20 border border-yellow-400/30 text-[10px] font-bold text-yellow-300">LIVE X</span>
                        </div>
                        <div class="self-center my-auto z-10 text-5xl drop-shadow-lg group-hover:scale-110 transition animate-float">
                            🚀
                        </div>
                        <div class="z-10">
                            <div class="text-base font-black text-white tracking-tight">Краш</div>
                            <div class="text-[11px] text-purple-200/80 font-medium">Успей забрать</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================= ЭКРАН ОТКРЫТИЯ КЕЙСОВ ================= -->
            <div id="view-case" class="hidden space-y-4">
                <div class="flex items-center justify-between">
                    <button onclick="switchTab('games')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/15 active:scale-95 transition text-xs font-bold text-white">
                        <span>←</span> Назад
                    </button>
                    <span class="text-xs font-extrabold uppercase tracking-wider text-purple-300">Открытие кейсов</span>
                    <button onclick="resetDailyTimer()" class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] text-gray-400 hover:text-white">
                        Сброс 24ч
                    </button>
                </div>

                <div class="grid grid-cols-3 gap-2">
                    <button id="case-tab-daily" onclick="selectCaseType('daily')" class="p-2.5 rounded-2xl border border-sr-gold bg-sr-gold/15 text-center transition">
                        <div class="text-lg">🎁</div>
                        <div class="text-xs font-black text-white mt-0.5">Daily Case</div>
                        <div class="text-[10px] font-bold text-sr-gold">Бесплатно</div>
                    </button>
                    <button id="case-tab-neon" onclick="selectCaseType('neon')" class="p-2.5 rounded-2xl border border-white/10 bg-sr-card text-center transition">
                        <div class="text-lg">🔮</div>
                        <div class="text-xs font-black text-white mt-0.5">Neon Case</div>
                        <div class="text-[10px] font-bold text-purple-300">200 монет</div>
                    </button>
                    <button id="case-tab-gold" onclick="selectCaseType('gold')" class="p-2.5 rounded-2xl border border-white/10 bg-sr-card text-center transition">
                        <div class="text-lg">👑</div>
                        <div class="text-xs font-black text-white mt-0.5">Royal Case</div>
                        <div class="text-[10px] font-bold text-yellow-400">750 монет</div>
                    </button>
                </div>

                <!-- ОКНО РУЛЕТКИ -->
                <div id="roulette-box" class="relative bg-[#11111A] border border-purple-500/30 rounded-3xl py-6 overflow-hidden shadow-inner">
                    <div class="absolute top-1.5 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center">
                        <div class="w-0 h-0 border-l-[10px] border-l-transparent border-r-[10px] border-r-transparent border-t-[12px] border-t-sr-gold drop-shadow-[0_0_8px_rgba(250,204,21,0.9)]"></div>
                    </div>

                    <div class="absolute top-3 bottom-3 left-1/2 -translate-x-1/2 w-[2px] bg-gradient-to-b from-sr-gold via-purple-400 to-sr-gold z-20 opacity-80"></div>

                    <div class="absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-[#11111A] to-transparent z-20 pointer-events-none"></div>
                    <div class="absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-[#11111A] to-transparent z-20 pointer-events-none"></div>

                    <div id="roulette-viewport" class="relative w-full overflow-hidden py-2">
                        <div id="roulette-track" class="flex items-center gap-2.5 will-change-transform" style="transform: translateX(0px);"></div>
                    </div>

                    <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center">
                        <div class="w-0 h-0 border-l-[10px] border-l-transparent border-r-[10px] border-r-transparent border-b-[12px] border-b-sr-gold drop-shadow-[0_0_8px_rgba(250,204,21,0.9)]"></div>
                    </div>
                </div>

                <button id="btn-spin-case" onclick="spinCase()" class="w-full py-4 rounded-2xl font-black text-base tracking-wide uppercase transition active:scale-95 bg-gradient-to-r from-sr-purple via-sr-violet to-purple-600 text-white shadow-lg shadow-purple-600/40">
                    Открыть бесплатно
                </button>

                <div class="space-y-2 pt-1">
                    <div class="text-xs font-extrabold uppercase tracking-wider text-white/80">Содержимое кейса</div>
                    <div id="case-contents-grid" class="grid grid-cols-3 gap-2"></div>
                </div>
            </div>

            <!-- ================= ЭКРАН ИГРЫ: СЛОТЫ ================= -->
            <div id="view-slots" class="hidden space-y-4">
                <div class="flex items-center justify-between">
                    <button onclick="switchTab('games')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/15 active:scale-95 transition text-xs font-bold text-white">
                        <span>←</span> Назад
                    </button>
                    <span class="text-xs font-extrabold uppercase tracking-wider text-yellow-400">SR_Game Slots 777</span>
                    <span class="text-[11px] text-gray-400">3 в ряд = x8..x25</span>
                </div>

                <div class="bg-gradient-to-b from-[#1C1630] to-[#11111A] border border-yellow-400/30 rounded-3xl p-5 space-y-4 shadow-xl">
                    <div class="text-center">
                        <span id="slots-status" class="inline-block px-3 py-1 rounded-full bg-white/5 text-xs font-bold text-purple-200">
                            Сделай ставку и крути барабаны!
                        </span>
                    </div>

                    <div class="grid grid-cols-3 gap-3 bg-[#09090E] p-3.5 rounded-2xl border border-purple-500/30">
                        <div id="reel-0" class="h-24 rounded-xl bg-sr-card border border-white/10 flex items-center justify-center text-4xl shadow-inner transition-transform">
                            💎
                        </div>
                        <div id="reel-1" class="h-24 rounded-xl bg-sr-card border border-white/10 flex items-center justify-center text-4xl shadow-inner transition-transform">
                            7️⃣
                        </div>
                        <div id="reel-2" class="h-24 rounded-xl bg-sr-card border border-white/10 flex items-center justify-center text-4xl shadow-inner transition-transform">
                            👑
                        </div>
                    </div>

                    <div class="grid grid-cols-4 gap-1.5 text-center text-[10px] font-bold text-gray-300 bg-white/5 rounded-xl p-2">
                        <div>7️⃣7️⃣7️⃣ <span class="text-sr-gold block">x25</span></div>
                        <div>👑👑👑 <span class="text-sr-gold block">x12</span></div>
                        <div>💎💎💎 <span class="text-purple-400 block">x8</span></div>
                        <div>2 совп. <span class="text-emerald-400 block">x1.5</span></div>
                    </div>
                </div>

                <div class="bg-sr-card border border-white/10 rounded-2xl p-3 space-y-2.5">
                    <div class="flex justify-between text-xs font-bold text-gray-400">
                        <span>Ставка (монет):</span>
                        <span id="slots-bet-label" class="text-white">25 монет</span>
                    </div>
                    <div class="grid grid-cols-4 gap-2">
                        <button onclick="setSlotsBet(10)" class="slots-bet-btn py-2 rounded-xl text-xs font-extrabold bg-white/5 border border-white/10 text-white">10</button>
                        <button onclick="setSlotsBet(25)" class="slots-bet-btn py-2 rounded-xl text-xs font-extrabold bg-sr-purple/30 border border-sr-purple text-white">25</button>
                        <button onclick="setSlotsBet(50)" class="slots-bet-btn py-2 rounded-xl text-xs font-extrabold bg-white/5 border border-white/10 text-white">50</button>
                        <button onclick="setSlotsBet(100)" class="slots-bet-btn py-2 rounded-xl text-xs font-extrabold bg-white/5 border border-white/10 text-white">100</button>
